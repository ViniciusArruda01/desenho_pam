<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="desenho.AppChiquinha"
             Title="">
    <VerticalStackLayout
        BackgroundColor="#D54646">
        
        <Label 
        Text="Chiquinha"
        VerticalOptions="Center" 
        HorizontalOptions="Center"
            Style="{StaticResource Headline}"
FontSize="Large" 
FontAttributes="Bold"
            TextColor="LightGray"/>

        <Image
Source="chiquinha.jpg"
HeightRequest="185"
Aspect="AspectFit"
SemanticProperties.Description="dot net bot in a hovercraft number nine"
/>


        <Label 
Text=" Chiquinha  é filha de Seu Madruga e se destaca por sua inteligência, esperteza e personalidade travessa. Ela frequentemente cria planos e brincadeiras para conseguir o que quer ou simplesmente se divertir. É muito próxima do Chaves e costuma participar das disputas e confusões entre as crianças. Também tem um lado bastante carinhoso, especialmente com o Chaves, embora muitas vezes aproveite a ingenuidade dele para fazer brincadeiras."
VerticalOptions="Center" 
HorizontalOptions="Center" 
        Margin="30,30,30,0"
        HorizontalTextAlignment="Justify"
             TextColor="LightGray"/>
    </VerticalStackLayout>
</ContentPage>