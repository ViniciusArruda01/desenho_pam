<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="desenho.AppChaves"
             Title="">
    <VerticalStackLayout
        BackgroundColor="#195319">
        <Label 
            Text="Chaves"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontSize="Large" 
FontAttributes="Bold"
             TextColor="LightGray"/>

        <Image
    Source="chaves.jpg"
    HeightRequest="185"
    Aspect="AspectFit"
    SemanticProperties.Description="dot net bot in a hovercraft number nine"
    />


        <Label 
    Text="Chaves  é o protagonista da série. É um menino órfão, humilde e bastante inocente, que vive em uma vila e costuma se esconder dentro de um barril. Apesar de não ter muitos recursos, é muito criativo e se diverte com coisas simples. Seu jeito atrapalhado acaba colocando os moradores em diversas confusões, muitas vezes sem que ele tenha intenção de causar problemas. É muito amigo de Chiquinha e Quico."
    VerticalOptions="Center" 
    HorizontalOptions="Center" 
            Margin="30,30,30,0"
            HorizontalTextAlignment="Justify"
             TextColor="LightGray"/>
    </VerticalStackLayout>
</ContentPage>