<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="desenho.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Chaves"
                Style="{StaticResource Headline}"
                FontSize="Medium" />
            
            <Image
                Source="turma_chaves_index.jpg"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a hovercraft number nine"
                />



            <Label
                Text="O seriado Chaves mundialmente conhecido pelo humor, e particularmente um dos meus  favoritos"
                Style="{StaticResource SubHeadline}"
                FontSize="17"
                SemanticProperties.Description="Welcome to dot net Multi platform App U I" />
            <Label
                Text="Vamos conhecer os, acesse o menu acima"
                Style="{StaticResource SubHeadline}"
                FontSize="17"
                SemanticProperties.Description="Welcome to dot net Multi platform App U I" />

            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
